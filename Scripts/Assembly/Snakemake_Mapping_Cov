import pandas as pd
import re 
import os

#Your paths
Genomes_dir="/beegfs/project/horizon/data/assembly/species/"
Reads_dir="/beegfs/project/horizon/data/trimmed_reads/"
Output_dir="/beegfs/project/horizon/data/mapping/"
Scripts_dir="/beegfs/data/soukkal/Thesis/Horizon/Scripts"
logs_dir="/beegfs/data/soukkal/Thesis/Horizon/Mapping/logs/"

#Softwares : 
Soft_dir="/beegfs/home/soukkal/miniconda3/bin/"

Genome_IDS_table=pd.read_csv("/beegfs/data/soukkal/Thesis/Horizon/species_list_236.txt",header=None)
list_Genome_IDs=list(Genome_IDS_table[0])

#This rule contains all the expected output from all your rules within the snakefile
rule all:
        input:
                expand(logs_dir+"{Genome_ID}_index_done.txt", Genome_ID = list_Genome_IDs),
                expand(Output_dir+"bam/{Genome_ID}_sp1.bam.gz", Genome_ID = list_Genome_IDs),
                expand(Output_dir+"bam/{Genome_ID}_sp2.bam.gz", Genome_ID = list_Genome_IDs),
                expand(Output_dir+"bed/{Genome_ID}_sp1.per-base.bed.gz", Genome_ID = list_Genome_IDs),
                expand(Output_dir+"bed/{Genome_ID}_sp2.per-base.bed.gz", Genome_ID = list_Genome_IDs),
                expand(Output_dir+"cov/{Genome_ID}_sp1.cov", Genome_ID = list_Genome_IDs),
                expand(Output_dir+"cov/{Genome_ID}_sp2.cov", Genome_ID = list_Genome_IDs)

rule index_genome:
        params:
                threads="8",
                partition="normal",
                time="03:00:00",
                mem="32G",
                name="Index_{Genome_ID}",
                out=logs_dir+"{Genome_ID}_index.out",
                err=logs_dir+"{Genome_ID}_index.error"
        input:
                Genome=Genomes_dir+"{Genome_ID}/gnm.fna"
        output:
                flag=logs_dir+"{Genome_ID}_index_done.txt"
        shell:
                """
                {Soft_dir}bwa-mem2.avx2 index {input.Genome}
                touch {output.flag}
                """

rule Mapping_Sp1:
        params:
                threads="8",
                partition="normal",
                time="12:00:00",
                mem="32G",
                name="Mapping_S1_{Genome_ID}",
                out=logs_dir+"{Genome_ID}_map_S1.out",
                err=logs_dir+"{Genome_ID}_map_S1.error"
        input:
                flag=logs_dir+"{Genome_ID}_index_done.txt",
                Genome=Genomes_dir+"{Genome_ID}/gnm.fna",
                R1=Reads_dir+"{Genome_ID}_sp1_1.fq.gz", #Trimmed reads
                R2=Reads_dir+"{Genome_ID}_sp1_2.fq.gz"
        output:
                BAM_zipped=Output_dir+"bam/{Genome_ID}_sp1.bam.gz"
        shell:
                """
                {Soft_dir}bwa-mem2.avx2 mem -t 8 {input.Genome} {input.R1} {input.R2} > /beegfs/project/horizon/data/mapping/bam/{wildcards.Genome_ID}_sp1.bam
                gzip /beegfs/project/horizon/data/mapping/bam/{wildcards.Genome_ID}_sp1.bam
                """

rule Mapping_Sp2:
        params:
                threads="8",
                partition="normal",
                time="12:00:00",
                mem="32G",
                name="Mapping_S2_{Genome_ID}",
                out=logs_dir+"{Genome_ID}_map_S2.out",
                err=logs_dir+"{Genome_ID}_map_S2.error"
        input:
                flag=logs_dir+"{Genome_ID}_index_done.txt",
                Genome=Genomes_dir+"{Genome_ID}/gnm.fna",
                R1=Reads_dir+"{Genome_ID}_sp2_1.fq.gz", #Trimmed reads
                R2=Reads_dir+"{Genome_ID}_sp2_2.fq.gz"
        output:
                BAM_zipped=Output_dir+"bam/{Genome_ID}_sp2.bam.gz"
        shell:
                """
                hostname
                {Soft_dir}bwa-mem2.avx2 mem -t 8 {input.Genome} {input.R1} {input.R2} > /beegfs/project/horizon/data/mapping/bam/{wildcards.Genome_ID}_sp2.bam
                gzip /beegfs/project/horizon/data/mapping/bam/{wildcards.Genome_ID}_sp2.bam
                """

rule Coverage_Sp1:
        params:
                threads="8",
                partition="normal",
                time="24:00:00",
                mem="8G",
                name="Coverage_S1_{Genome_ID}",
                out=logs_dir+"{Genome_ID}_cov_S1.out",
                err=logs_dir+"{Genome_ID}_cov_S1.error"
        input:
                BAM=Output_dir+"bam/{Genome_ID}_sp1.bam.gz"
        output:
                BED=Output_dir+"bed/{Genome_ID}_sp1.per-base.bed.gz"
        shell:
                """
                {Soft_dir}samtools sort {input.BAM} -l 1 -o {Output_dir}bam/{wildcards.Genome_ID}_sp1_sorted.bam.gz
                {Soft_dir}samtools depth -a {Output_dir}bam/{wildcards.Genome_ID}_sp1_sorted.bam.gz > {Output_dir}bed/{wildcards.Genome_ID}_sp1.per-base.bed
                gzip {Output_dir}bed/{wildcards.Genome_ID}_sp1.per-base.bed
                rm {Output_dir}bam/{wildcards.Genome_ID}_sp1_sorted.bam.gz
                """

rule Coverage_Sp2:
        params:
                threads="8",
                partition="normal",
                time="24:00:00",
                mem="8G",
                name="Coverage_S2_{Genome_ID}",
                out=logs_dir+"{Genome_ID}_cov_S2.out",
                err=logs_dir+"{Genome_ID}_cov_S2.error"
        input:
                BAM=Output_dir+"bam/{Genome_ID}_sp2.bam.gz"
        output:
                BED=Output_dir+"bed/{Genome_ID}_sp2.per-base.bed.gz"
        shell:
                """
                {Soft_dir}samtools sort {input.BAM} -l 1 -o {Output_dir}bam/{wildcards.Genome_ID}_sp2_sorted.bam.gz
                {Soft_dir}samtools depth -a {Output_dir}bam/{wildcards.Genome_ID}_sp2_sorted.bam.gz > {Output_dir}bed/{wildcards.Genome_ID}_sp2.per-base.bed
                gzip {Output_dir}bed/{wildcards.Genome_ID}_sp2.per-base.bed
                rm {Output_dir}bam/{wildcards.Genome_ID}_sp2_sorted.bam.gz
                """

rule Mean_Sp1:
        params:
                threads="4",
                partition="normal",
                time="20:00:00",
                mem="1G",
                name="Cov_S1_{Genome_ID}",
                out=logs_dir+"{Genome_ID}_mean_cov_S1.out",
                err=logs_dir+"{Genome_ID}_mean_cov_S1.error"
        input:
                BAM=Output_dir+"bam/{Genome_ID}_sp1.bam.gz"
        output:
                Cov=Output_dir+"cov/{Genome_ID}_sp1.cov"
        shell:
                """
                hostname
                {Soft_dir}samtools sort {input.BAM} -l 1 -o {Output_dir}bam/{wildcards.Genome_ID}_sp1_sorted2.bam.gz
                /beegfs/data/soft/samtools-1.10/bin/samtools coverage -o {output.Cov} {Output_dir}bam/{wildcards.Genome_ID}_sp1_sorted2.bam.gz 
                rm {Output_dir}bam/{wildcards.Genome_ID}_sp1_sorted2.bam.gz
                """

rule Mean_Sp2:
        params:
                threads="4",
                partition="normal",
                time="20:00:00",
                mem="1G",
                name="Cov_S2_{Genome_ID}",
                out=logs_dir+"{Genome_ID}_mean_cov_S2.out",
                err=logs_dir+"{Genome_ID}_mean_cov_S2.error"
        input:
                BAM=Output_dir+"bam/{Genome_ID}_sp2.bam.gz"
        output:
                Cov=Output_dir+"cov/{Genome_ID}_sp2.cov"
        shell:
                """
                hostname
                {Soft_dir}samtools sort {input.BAM} -l 1 -o {Output_dir}bam/{wildcards.Genome_ID}_sp2_sorted2.bam.gz
                /beegfs/data/soft/samtools-1.10/bin/samtools coverage -o {output.Cov} {Output_dir}bam/{wildcards.Genome_ID}_sp2_sorted2.bam.gz
                rm {Output_dir}bam/{wildcards.Genome_ID}_sp2_sorted2.bam.gz
                """
